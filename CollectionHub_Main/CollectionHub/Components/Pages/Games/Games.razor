@using CollectionHub.Components.Services
@using CollectionHub.Shared.Dtos
@page "/"


<h3>Games</h3>

<input type="text" class="form-control search-input" placeholder="Search..." @bind-value="_searchText" @bind-value:event="oninput" />

<button class="btn btn-primary" @onclick="@(() => SearchGames(_searchText))">Search</button>

<table>   
    @foreach (var game in _searchGames)
    {    
      <tr>
        <td><span>@game.Name</span></td>
        <td><button class="btn btn-primary" @onclick="@(() => AddTwitchGame(game))">Add Game</button></td>
      </tr>  
    }
</table>


<GameTable Games="games" OnDelete="DeleteGame" OnEdit="GetGame" OnSubmit="SubmitGame"/>

<GameForm OnSubmit="AddGame" Game="new()"/>


@code {

    private string _searchText = "";
    private List<IgdbGameDto> _searchGames = new();

    private List<GameDto> games = [];

    protected override async Task OnInitializedAsync()
    {
        games = await gameApiService.GetGamesAsync();
    }

    [Inject]
    public IGameApiService gameApiService { get; set; } = default!;

    private async Task DeleteGame(GameDto game)
    {
        await gameApiService.DeleteGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task AddTwitchGame(IgdbGameDto game)
    {
        var gameDto = new GameDto
            {
                Id = Guid.NewGuid(),
                Title = game.Name,
                Status = CollectionStatus.Backlog,
                Rating = (int)Math.Round(game.Rating, 1),
                Notes = game.Summary,
                FirstReleaseDate = DateTimeOffset.FromUnixTimeSeconds(game.FirstReleaseDate).ToString("dd.MM.yyyy"),
                Cover = await gameApiService.SearchCover(game.CoverId)
            };

        await AddGame(gameDto);
    }

    private async Task AddGame(GameDto game)
    {
        await gameApiService.PostGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task GetGame(GameDto game)
    {
        await gameApiService.GetGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task SubmitGame(GameDto game)
    {
        await gameApiService.UpdateGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task SearchGames(string gameName)
    {
        _searchGames = await gameApiService.SearchGames(gameName);
        await InvokeAsync(StateHasChanged);
    }
}
