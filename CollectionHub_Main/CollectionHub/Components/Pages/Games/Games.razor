@using CollectionHub.Components.Services
@page "/"


<h3>Games</h3>

<GameTable Games="gameService.GetAll()" OnDelete="DeleteGame" OnEdit="EditGame" OnSubmit="SubmitGame"/>

<GameForm OnSubmit="AddGame" Game="new()"/>


@code {

    [Inject]
    public IGameService gameService { get; set; } = default!;

    private void DeleteGame(Game game)
    {
        gameService.Delete(game);
    }

    private void AddGame(Game game)
    {
        gameService.Add(game);
    }

    private void EditGame(Game game)
    {
        gameService.Edit(game);
    }

    private void SubmitGame(Game game)
    {
        gameService.Update(game);
    }
}
