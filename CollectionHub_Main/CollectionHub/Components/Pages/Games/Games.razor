@using CollectionHub.Components.Services;
@using CollectionHub.Shared.Dtos.Game;
@page "/"

<h3>Animes</h3>

<div class="d-flex gap-2 mb-3">
    <input type="text"
           class="form-control search-input"
           placeholder="Search..."
           @bind-value="_searchText"
           @bind-value:event="oninput"
           disabled="@_isSearching" />

    <button class="btn btn-primary"
            disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchText))"
            @onclick="SearchGamesAsync">
        @if (_isSearching)
        {
            <span class="spinner-border spinner-border-sm me-2"
                  aria-hidden="true"></span>
            <span>Searching...</span>
        }
        else
        {
            <span>Search</span>
        }
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_searchError))
{
    <div class="alert alert-danger" role="alert">
        @_searchError
    </div>
}

@if (_isSearching)
{
    <p>Searching IGDB and loading covers...</p>
}
else if (_searchGames.Count > 0)
{
    <GameSearchResultList @key="_searchGames"
                          SearchGames="_searchGames"
                          OnAdd="AddTwitchGame" />
}
else if (_hasSearched)
{
    <div class="alert alert-info" role="status">
        No games were found for this search.
    </div>
}


<GameTable Games="games" OnDelete="DeleteGame" OnEdit="GetGame" OnSubmit="SubmitGame"/>

<GameForm OnSubmit="AddGame" Game="new()"/>


@code {

    [Inject]
    public IGameApiService GameApiService { get; set; } = default!;

    private string? _searchError;
    private bool _isSearching;
    private bool _hasSearched;

    private string _searchText = "";
    private List<IgdbGameDto> _searchGames = new();
    private List<GameDto> games = [];

    protected override async Task OnInitializedAsync()
    {
        games = await GameApiService.GetGamesAsync();
    }

    private async Task DeleteGame(GameDto game)
    {
        await GameApiService.DeleteGameAsync(game);
        games = await GameApiService.GetGamesAsync();
    }

    private async Task AddTwitchGame(GameDto game)
    {
        await AddGame(game);
        _searchGames.Clear();
        _searchText = "";
    }

    private async Task AddGame(GameDto game)
    {
        await GameApiService.PostGameAsync(game);
        games = await GameApiService.GetGamesAsync();
    }

    private async Task GetGame(GameDto game)
    {
        await GameApiService.GetGameAsync(game);
        games = await GameApiService.GetGamesAsync();
    }

    private async Task SubmitGame(GameDto game)
    {
        await GameApiService.UpdateGameAsync(game);
        games = await GameApiService.GetGamesAsync();
    }

    private async Task SearchGamesAsync()
    {
        if (_isSearching ||
            string.IsNullOrWhiteSpace(_searchText))
        {
            return;
        }

        _isSearching = true;
        _hasSearched = false;
        _searchError = null;
        _searchGames.Clear();

        try
        {
                _searchGames =
                await GameApiService.SearchGamesAsync(
                    _searchText);
        }
        catch (Exception)
        {
            _searchError =
                "The game search is currently unavailable. Please try again.";
        }
        finally
        {
            _isSearching = false;
            _hasSearched = true;
        }
    }
}
