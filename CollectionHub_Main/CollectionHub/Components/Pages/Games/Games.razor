@using CollectionHub.Components.Services
@using CollectionHub.Shared.Dtos
@page "/"


<h3>Games</h3>

<GameTable Games="games" OnDelete="DeleteGame" OnEdit="GetGame" OnSubmit="SubmitGame"/>

<GameForm OnSubmit="AddGame" Game="new()"/>


@code {

    private List<GameDto> games = [];

    protected override async Task OnInitializedAsync()
    {
        games = await gameApiService.GetGamesAsync();
    }

    [Inject]
    public IGameApiService gameApiService { get; set; } = default!;

    private async Task DeleteGame(GameDto game)
    {
        await gameApiService.DeleteGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task AddGame(GameDto game)
    {
        await gameApiService.PostGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task GetGame(GameDto game)
    {
        await gameApiService.GetGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }

    private async Task SubmitGame(GameDto game)
    {
        await gameApiService.UpdateGameAsync(game);
        games = await gameApiService.GetGamesAsync();
    }
}
