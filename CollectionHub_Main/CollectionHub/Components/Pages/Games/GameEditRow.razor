@using CollectionHub.Shared.Dtos.Game

<tr>
    <td>
        @if (!string.IsNullOrWhiteSpace(_editedGame.Cover))
        {
            <img class="edit-cover"
                 src="@_editedGame.Cover"
                 alt="Cover of @_editedGame.Title" />
        }
        else
        {
            <div class="edit-cover-placeholder">
                No cover
            </div>
        }
    </td>
    <td>
        <InputText class="form-control" @bind-Value="_editedGame.Title" />
    </td>
    <td>
        <InputSelect class="form-select" @bind-Value="_editedGame.Status">
            @foreach (var status in Enum.GetValues<CollectionStatus>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </td>
    <td>
        <InputSelect class="form-select" @bind-Value="_editedGame.Rating">
            @for (int i = 1; i <= 10; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </td>
    <td>
        <InputText class="form-control" @bind-Value="_editedGame.FirstReleaseDate" />
    </td>
    <td>
        <InputText class="form-control" @bind-Value="_editedGame.Notes" />
    </td>
    <td>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-primary"
                    @onclick="SubmitGame">
                Update
            </button>

            <button class="btn btn-sm btn-secondary"
                    @onclick="OnCancel">
                Cancel
            </button>
        </div>
    </td>
</tr>


@code {

    [Parameter]
    public EventCallback<GameDto> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public GameDto Game { get; set; } = default!;

    private GameDto _editedGame = new();

    protected override void OnInitialized()
    {
        _editedGame = new GameDto
        {
            Id = Game.Id,
            Title = Game.Title,
            Status = Game.Status,
            Rating = Game.Rating,
            FirstReleaseDate = Game.FirstReleaseDate,
            Notes = Game.Notes,
            Cover = Game.Cover,
            MediaType = Game.MediaType
        };
    }

    private async Task SubmitGame()
    {
        await OnSubmit.InvokeAsync(_editedGame);
    }

}

