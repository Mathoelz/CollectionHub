<h3>Insert new game</h3>

<table class="table">
    <tr style="font-weight:bold">
        <td>Title</td>
        <td>Status</td>
        <td>Rating</td>
        <td>Notes</td>
        <td></td>
    </tr>
    <tr>
        <td>
            <InputText @bind-Value="_game.Title" />
        </td>
        <td>
            <InputSelect @bind-Value="_game.Status">
                @foreach (var status in Enum.GetValues<CollectionStatus>())
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </td>
        <td>
            <InputSelect @bind-Value="_game.Rating">
                @for (int i = 1; i <= 10; i++)
                {
                    <option value="@i">@i</option>
                }
            </InputSelect>
        </td>
        <td>
            <InputText @bind-Value="_game.Notes" />
        </td>
        <td>
            <button class="btn btn-primary" @onclick="AddGame">Add</button>
        </td>
    </tr>
</table>

@code {

    private Game _game = new();

    [Parameter]
    public EventCallback<Game> OnAdd { get; set; }

    private async Task AddGame()
    {
        _game.Id = Guid.NewGuid();

        await OnAdd.InvokeAsync(_game);
        _game = new Game
        {
            Status = CollectionStatus.Backlog,
            Rating = 1
        };
    }
}

