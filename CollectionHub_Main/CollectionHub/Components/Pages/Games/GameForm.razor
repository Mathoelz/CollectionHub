@using CollectionHub.Shared.Dtos.Game
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized Context="authState">
        <section class="mt-4">
            <h2 class="h4">Add a game manually</h2>

            <EditForm Model="_newGame"
                      OnValidSubmit="AddGame">
                <DataAnnotationsValidator />

                <div class="card">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"
                                       for="game-title">
                                    Title
                                </label>

                                <InputText id="game-title"
                                           class="form-control"
                                           @bind-Value="_newGame.Title" />

                                <ValidationMessage For="@(() => _newGame.Title)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label"
                                       for="game-status">
                                    Status
                                </label>

                                <InputSelect id="game-status"
                                             class="form-select"
                                             @bind-Value="_newGame.Status">
                                    @foreach (var status in Enum.GetValues<CollectionStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label"
                                       for="game-rating">
                                    Rating
                                </label>

                                <InputSelect id="game-rating"
                                             class="form-select"
                                             @bind-Value="_newGame.Rating">
                                    @for (int rating = 1; rating <= 10; rating++)
                                    {
                                        <option value="@rating">@rating</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label"
                                       for="game-notes">
                                    Notes
                                </label>

                                <InputTextArea id="game-notes"
                                               class="form-control"
                                               rows="3"
                                               @bind-Value="_newGame.Notes" />

                                <ValidationMessage For="@(() => _newGame.Notes)" />
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary"
                                        type="submit"
                                        disabled="@_isSubmitting">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"
                                              aria-hidden="true"></span>
                                        <span>Adding...</span>
                                    }
                                    else
                                    {
                                        <span>Add game</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </section>
    </Authorized>

    <NotAuthorized>
        <div class="alert alert-secondary mt-4" role="status">
            Log in to add games to the collection.
        </div>
    </NotAuthorized>
</AuthorizeView>


@code {

    [Parameter]
    public EventCallback<GameDto> OnSubmit { get; set; }

    private bool _isSubmitting;

    private GameDto _newGame = CreateNewGame();

    private static GameDto CreateNewGame()
    {
        return new GameDto
        {
            Status = CollectionStatus.Backlog,
            Rating = 1
        };
    }

    private async Task AddGame()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            _newGame.Id = Guid.NewGuid();

            await OnSubmit.InvokeAsync(_newGame);

            _newGame = CreateNewGame();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

}

