@using CollectionHub.Shared.Dtos.Game

<table class="table">
    <tr style="font-weight:bold;">
        <td></td>
        <td>Title</td>
        <td>Status</td>
        <td>Rating</td>
        <td>First release date</td>
        <td>Notes</td>
    </tr>
    @foreach (var game in Games)
    {
        if(isEditing && game.Id == editingGameId)
        {
            <GameEditRow isEditing="true" OnCancel="StopEditing" Game="game" OnSubmit="SubmitGame" />
        }
        else if(game.Id == deleteGameId)
        {
            <tr>
                <td colspan="5">
                    <div class="alert alert-danger" role="alert">
                        Are you sure you want to delete <strong>@game.Title</strong>?
                        <button class="btn btn-danger" @onclick="@(() => DeleteGame(game))">Yes</button>
                        <button class="btn btn-secondary" @onclick="@(() => deleteGameId = Guid.Empty)">No</button>
                    </div>
                </td>
            </tr>
            
        }
        else
        {
            <tr>
                <td><img src="@(string.IsNullOrEmpty(game.Cover) ? "" : game.Cover)" alt="@game.Title" style="width: 150px; height: auto;" /></td>
                <td>@game.Title</td>
                <td>@game.Status</td>
                <td>@game.Rating</td>
                <td>@game.FirstReleaseDate</td>
                <td>@game.Notes</td>
                <button class="btn btn-danger" @onclick="@(() => FlagGameForDeletion(game))">Delete</button>
                <button class="btn btn-primary" @onclick="@(() => StartEditing(game))">Edit</button>
            </tr>
        }      
    }
</table>

@code {

    private bool isEditing = false;
    private Guid editingGameId;
    private Guid deleteGameId;

    [Parameter]
    public IReadOnlyList<GameDto> Games { get; set; } = [];

    [Parameter]
    public EventCallback<GameDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<GameDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<GameDto> OnSubmit { get; set; }

    private void FlagGameForDeletion(GameDto game)
    {
        isEditing = false;
        editingGameId = Guid.Empty;

        deleteGameId = game.Id;
    }

    private void StartEditing(GameDto game)
    {
        deleteGameId = Guid.Empty;

        isEditing = true;
        editingGameId = game.Id;
    }

    private void StopEditing()
    {
        isEditing = false;
        editingGameId = Guid.Empty;
    }

    private async Task SubmitGame(GameDto game)
    {
        await OnSubmit.InvokeAsync(game);
        StopEditing();
    }

    private async Task DeleteGame(GameDto game)
    {
        await OnDelete.InvokeAsync(game);
        deleteGameId = Guid.Empty;
    }
}
