<table class="table">
    <tr style="font-weight:bold;">
        <td>Title</td>
        <td>Status</td>
        <td>Rating</td>
        <td>Notes</td>
    </tr>
    @foreach (var game in Games)
    {
        if(isEditing && game.Id == editingGameId)
        {
            <GameEditRow isEditing="true" OnCancel="StopEditing" Game="game" OnSubmit="SubmitGame" />
        }
        else if(game.Id == deleteGameId)
        {
            <tr>
                <td colspan="5">
                    <div class="alert alert-danger" role="alert">
                        Are you sure you want to delete <strong>@game.Title</strong>?
                        <button class="btn btn-danger" @onclick="@(() => OnDelete.InvokeAsync(game))">Yes</button>
                        <button class="btn btn-secondary" @onclick="@(() => deleteGameId = Guid.Empty)">No</button>
                    </div>
                </td>
            </tr>
            
        }
        else
        {
            <tr>
                <td>@game.Title</td>
                <td>@game.Status</td>
                <td>@game.Rating</td>
                <td>@game.Notes</td>
                <button class="btn btn-danger" @onclick="@(() => FlagGameForDeletion(game))">Delete</button>
                <button class="btn btn-primary" @onclick="@(() => StartEditing(game))">Edit</button>
            </tr>
        }      
    }
</table>

@code {

    private bool isEditing = false;
    private Guid editingGameId;
    private Guid deleteGameId;

    [Parameter]
    public IReadOnlyList<Game> Games { get; set; } = [];

    [Parameter]
    public EventCallback<Game> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Game> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Game> OnSubmit { get; set; }

    private void FlagGameForDeletion(Game game)
    {
        isEditing = false;
        editingGameId = Guid.Empty;

        deleteGameId = game.Id;
    }

    private void StartEditing(Game game)
    {
        deleteGameId = Guid.Empty;

        isEditing = true;
        editingGameId = game.Id;
    }

    private void StopEditing()
    {
        isEditing = false;
        editingGameId = Guid.Empty;
    }

    private async Task SubmitGame(Game game)
    {
        await OnSubmit.InvokeAsync(game);
        StopEditing();
    }
}
