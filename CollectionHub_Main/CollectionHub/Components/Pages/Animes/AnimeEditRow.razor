@using CollectionHub.Shared.Dtos.Anime

<tr>
    <td>
        @if (!string.IsNullOrWhiteSpace(_editedAnime.Cover))
        {
            <img class="edit-cover"
                 src="@_editedAnime.Cover"
                 alt="Cover of @_editedAnime.Title" />
        }
        else
        {
            <div class="edit-cover-placeholder">
                No cover
            </div>
        }
    </td>
    <td>
        <InputText class="form-control"
                   @bind-Value="_editedAnime.Title" />
    </td>
    <td>
        <InputSelect class="form-select"
                     @bind-Value="_editedAnime.Status">
            @foreach (var status in Enum.GetValues<CollectionStatus>())
            {
                <option value="@status">@status</option>
            }
        </InputSelect>
    </td>
    <td>
        <InputSelect class="form-select"
                     @bind-Value="_editedAnime.Rating">
            @for (int i = 1; i <= 10; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </td>
    <td>
        <InputText class="form-control"
                   @bind-Value="_editedAnime.Notes" />
    </td>
    <td>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-primary"
                    @onclick="SubmitAnime">
                Update
            </button>

            <button class="btn btn-sm btn-secondary"
                    @onclick="OnCancel">
                Cancel
            </button>
        </div>
    </td>
</tr>

@code {
    [Parameter]
    public EventCallback<AnimeDto> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public AnimeDto Anime { get; set; } = default!;

    private AnimeDto _editedAnime = new();

    protected override void OnInitialized()
    {
        _editedAnime = new AnimeDto
        {
            Id = Anime.Id,
            Title = Anime.Title,
            Status = Anime.Status,
            Rating = Anime.Rating,
            Notes = Anime.Notes,
            Cover = Anime.Cover,
            MediaType = Anime.MediaType
        };
    }

    private async Task SubmitAnime()
    {
        await OnSubmit.InvokeAsync(_editedAnime);
    }
}