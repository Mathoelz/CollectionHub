@using CollectionHub.Components.Services
@page "/anime"

<h3>Animes</h3>

<AnimeTable Animes="animeService.GetAll()" OnDelete="DeleteAnime" />

<AnimeForm OnAdd="AddAnime" />

@code {

    [Inject]
    public IAnimeService animeService { get; set; } = default!;

    private void DeleteAnime(Anime anime)
    {
        animeService.Delete(anime);
    }

    private void AddAnime(Anime anime)
    {
        animeService.Add(anime);
    }
}
