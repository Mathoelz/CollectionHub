@using CollectionHub.Components.Services
@using CollectionHub.Shared.Dtos.Anime
@page "/anime"

<h3>Animes</h3>

<div class="d-flex gap-2 mb-3">
    <input type="text"
           class="form-control search-input"
           placeholder="Search..."
           @bind-value="_searchText"
           @bind-value:event="oninput"
           disabled="@_isSearching" />

    <button class="btn btn-primary"
            disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchText))"
            @onclick="SearchAnimesAsync">
        @if (_isSearching)
        {
            <span class="spinner-border spinner-border-sm me-2"
                  aria-hidden="true"></span>
            <span>Searching...</span>
        }
        else
        {
            <span>Search</span>
        }
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_searchError))
{
    <div class="alert alert-danger" role="alert">
        @_searchError
    </div>
}

@if (_isSearching)
{
    <p>Searching AniList for anime...</p>
}
else if (_searchAnimes.Count > 0)
{
    <AnimeSearchResultList SearchAnimes="_searchAnimes"
                           OnAdd="AddAniListAnime" />
}
else if (_hasSearched)
{
    <div class="alert alert-info" role="status">
        No anime were found for this search.
    </div>
}

<AnimeTable Animes="animes"
            OnDelete="DeleteAnime"
            OnEdit="GetAnime"
            OnSubmit="SubmitAnime" />

<AnimeForm OnAdd="AddAnime"
           Anime="new()" />

@code {
    [Inject]
    public IAnimeService AnimeApiService { get; set; } = default!;

    private string _searchText = "";
    private string? _searchError;
    private bool _isSearching;
    private bool _hasSearched;

    private List<AniListAnimeDto> _searchAnimes = [];
    private List<AnimeDto> animes = [];

    protected override async Task OnInitializedAsync()
    {
        animes = await AnimeApiService.GetAnimesAsync();
    }

    private async Task DeleteAnime(AnimeDto anime)
    {
        await AnimeApiService.DeleteAnimeAsync(anime);
        animes = await AnimeApiService.GetAnimesAsync();
    }

    private async Task AddAniListAnime(AnimeDto anime)
    {
        await AddAnime(anime);

        _searchAnimes.Clear();
        _searchText = "";
        _hasSearched = false;
    }

    private async Task AddAnime(AnimeDto anime)
    {
        await AnimeApiService.PostAnimeAsync(anime);
        animes = await AnimeApiService.GetAnimesAsync();
    }

    private async Task GetAnime(AnimeDto anime)
    {
        await AnimeApiService.GetAnimeAsync(anime);
        animes = await AnimeApiService.GetAnimesAsync();
    }

    private async Task SubmitAnime(AnimeDto anime)
    {
        await AnimeApiService.UpdateAnimeAsync(anime);
        animes = await AnimeApiService.GetAnimesAsync();
    }

    private async Task SearchAnimesAsync()
    {
        if (_isSearching ||
            string.IsNullOrWhiteSpace(_searchText))
        {
            return;
        }

        _isSearching = true;
        _hasSearched = false;
        _searchError = null;
        _searchAnimes.Clear();

        try
        {
            _searchAnimes =
                await AnimeApiService.SearchAnimesAsync(
                    _searchText);
        }
        catch (Exception)
        {
            _searchError =
                "The anime search is currently unavailable. Please try again.";
        }
        finally
        {
            _isSearching = false;
            _hasSearched = true;
        }
    }
}