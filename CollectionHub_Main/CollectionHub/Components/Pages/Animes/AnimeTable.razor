@using CollectionHub.Shared.Dtos.Anime
@using Microsoft.AspNetCore.Components.Authorization

<table class="table">
    <tr style="font-weight:bold;">
        <td>Title</td>
        <td>Status</td>
        <td>Rating</td>
        <td>Notes</td>
    </tr>
    @foreach (var anime in animes)
    {
        if (isEditing && anime.Id == editingAnimeId)
        {
            <AnimeEditRow isEditing="true" OnCancel="StopEditing" Anime="anime" OnSubmit="SubmitAnime" />
        }
        else if (anime.Id == deleteAnimeId)
        {
            <tr>
                <td colspan="4">
                    <div class="alert alert-danger" role="alert">
                        Are you sure you want to delete <strong>@anime.Title</strong>?
                        <button class="btn btn-danger" @onclick="@(() => DeleteAnime(anime))">Yes</button>
                        <button class="btn btn-secondary" @onclick="@(() => deleteAnimeId = Guid.Empty)">No</button>
                    </div>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td>@anime.Title</td>
                <td>@anime.Status</td>
                <td>@anime.Rating</td>
                <td>@anime.Notes</td>
                <td>
                    <AuthorizeView>
                        <Authorized>
                            <button class="btn btn-danger"
                                    @onclick="@(() => FlagAnimeForDeletion(anime))">
                                Delete
                            </button>
                
                            <button class="btn btn-primary"
                                    @onclick="@(() => StartEditing(anime))">
                                Edit
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </td>
            </tr>
        }
    }
</table>

@code {

    private bool isEditing = false;
    private Guid editingAnimeId;
    private Guid deleteAnimeId;

    [Parameter]
    public IReadOnlyList<AnimeDto> animes { get; set; } = [];

    [Parameter]
    public EventCallback<AnimeDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<AnimeDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<AnimeDto> OnSubmit { get; set; }

    private void FlagAnimeForDeletion(AnimeDto anime)
    {
        isEditing = false;
        editingAnimeId = Guid.Empty;
        deleteAnimeId = anime.Id;
    }

    private void StartEditing(AnimeDto anime)
    {
        deleteAnimeId = Guid.Empty;
        isEditing = true;
        editingAnimeId = anime.Id;
    }

    private void StopEditing()
    {
        isEditing = false;
        editingAnimeId = Guid.Empty;
    }

    private async Task SubmitAnime(AnimeDto anime)
    {
        await OnSubmit.InvokeAsync(anime);
        StopEditing();
    }

    private async Task DeleteAnime(AnimeDto anime)
    {
        await OnDelete.InvokeAsync(anime);
    }
}
