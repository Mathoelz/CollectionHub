@using CollectionHub.Shared.Dtos.Anime
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized Context="authState">
        <section class="mt-4">
            <h2 class="h4">Add an anime manually</h2>

            <EditForm Model="_newAnime"
                      OnValidSubmit="AddAnime">
                <DataAnnotationsValidator />

                <div class="card">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"
                                       for="anime-title">
                                    Title
                                </label>

                                <InputText id="anime-title"
                                           class="form-control"
                                           @bind-Value="_newAnime.Title" />

                                <ValidationMessage For="@(() => _newAnime.Title)" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label"
                                       for="anime-status">
                                    Status
                                </label>

                                <InputSelect id="anime-status"
                                             class="form-select"
                                             @bind-Value="_newAnime.Status">
                                    @foreach (var status in Enum.GetValues<CollectionStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label"
                                       for="anime-rating">
                                    Rating
                                </label>

                                <InputSelect id="anime-rating"
                                             class="form-select"
                                             @bind-Value="_newAnime.Rating">
                                    @for (int rating = 1; rating <= 10; rating++)
                                    {
                                        <option value="@rating">@rating</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label"
                                       for="anime-notes">
                                    Notes
                                </label>

                                <InputTextArea id="anime-notes"
                                               class="form-control"
                                               rows="3"
                                               @bind-Value="_newAnime.Notes" />

                                <ValidationMessage For="@(() => _newAnime.Notes)" />
                            </div>

                            <div class="col-12">
                                <button class="btn btn-primary"
                                        type="submit"
                                        disabled="@_isSubmitting">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"
                                              aria-hidden="true"></span>
                                        <span>Adding...</span>
                                    }
                                    else
                                    {
                                        <span>Add anime</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </section>
    </Authorized>

    <NotAuthorized>
        <div class="alert alert-secondary mt-4" role="status">
            Log in to add anime to the collection.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public EventCallback<AnimeDto> OnSubmit { get; set; }

    private bool _isSubmitting;

    private AnimeDto _newAnime = CreateNewAnime();

    private static AnimeDto CreateNewAnime()
    {
        return new AnimeDto
        {
            Status = CollectionStatus.Backlog,
            Rating = 1
        };
    }

    private async Task AddAnime()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            _newAnime.Id = Guid.NewGuid();

            await OnSubmit.InvokeAsync(_newAnime);

            _newAnime = CreateNewAnime();
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}