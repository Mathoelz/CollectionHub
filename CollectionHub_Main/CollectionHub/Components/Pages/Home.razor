@page "/"
@page "/home"

<PageTitle>CollectionHub</PageTitle>

<section class="home-hero">
    <p class="project-label">Azure portfolio project</p>

    <h1>Welcome to CollectionHub</h1>

    <p class="lead">
        Manage your game and anime collection in a cloud-native
        application built with Blazor and Azure.
    </p>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="games">
            Browse games
        </a>

        <a class="btn btn-outline-primary" href="anime">
            Browse anime
        </a>
    </div>
</section>

<section class="mt-4">
    <h2 class="h4">Built with</h2>

    <div class="d-flex flex-wrap gap-2">
        <span class="badge text-bg-secondary">Blazor</span>
        <span class="badge text-bg-secondary">Azure Functions</span>
        <span class="badge text-bg-secondary">Cosmos DB</span>
        <span class="badge text-bg-secondary">Blob Storage</span>
        <span class="badge text-bg-secondary">Key Vault</span>
        <span class="badge text-bg-secondary">Microsoft Entra ID</span>
        <span class="badge text-bg-secondary">Application Insights</span>
        <span class="badge text-bg-secondary">Docker</span>
    </div>
</section>