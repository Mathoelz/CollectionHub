@using Services
@using System.Text.Json
@page "/home"

<PageTitle>Home</PageTitle>

<h1>Hello, Docker world!</h1>

<button class="btn btn-primary" @onclick="ChangeText">API Test</button>

@welcomeText

@code {

    public string welcomeText = "Welcome to your new app.";

    [Inject]
    public HelloApiService helloApi { get; set; } = default!;

    public async Task ChangeText()
    {
        var result = await helloApi.GetHelloMessageAsync();

        var message = JsonSerializer.Deserialize<Dictionary<String,String>>(result);

        if(message != null) 
            welcomeText = message["message"];
    }

}